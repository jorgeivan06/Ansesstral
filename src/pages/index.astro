---

import Layout from '../layouts/Layout.astro';
import SobreNosotros from '../components/sobre nosotros.astro';
import MisProductos from '../components/Mis Productos.astro';
import Contacto from '../components/contacto.astro';
import Chatbot from '../components/chatbot/chatbot.astro';
---

<Layout>
	<main class="w-full">
		<section id="home" class="relative h-[90vh] flex flex-col justify-center items-center text-center px-4 overflow-hidden rounded-b-[3rem] shadow-2xl">
      <!-- Background Image with Zoom Effect -->
      <div class="absolute inset-0 z-0">
        <img src="/varios.jpeg" alt="Fondo Artesanías" class="w-full h-full object-cover scale-105 transition-transform duration-1000" />
        <div class="absolute inset-0 bg-gradient-to-b from-stone-900/70 via-stone-900/40 to-stone-900/80"></div>
      </div>

			<div class="relative z-10 max-w-3xl mx-auto">
			  <h1 class="text-5xl md:text-7xl font-bold text-amber-400 mb-6 drop-shadow-lg leading-tight">
          Bienvenido a <span class="text-white">Ansesstral</span>
        </h1>
			  <p class="text-xl md:text-2xl text-stone-200 mb-8 font-light italic tracking-wide">
				"La sabiduría de nuestros ancestros vive en cada hebra de la caña flecha"
			  </p>
        <div class="flex gap-4 justify-center">
          <a href="#productos" class="bg-amber-600 hover:bg-amber-500 text-white px-8 py-3 rounded-full font-bold transition-all transform hover:scale-105 shadow-lg">
            Ver Productos
          </a>
          <a href="#about" class="bg-white/10 hover:bg-white/20 backdrop-blur-md text-white border border-white/30 px-8 py-3 rounded-full font-bold transition-all transform hover:scale-105">
            Nuestra Historia
          </a>
        </div>
			</div>
		</section>
			
    <div class="space-y-24 py-20">
      <SobreNosotros/>
      <MisProductos/>
      <Contacto/>
    </div>
	</main>
	<Chatbot/>
</Layout>
  