---
import ProductosCarousel from '../components/ProductosCarousel.jsx';
---

<section id="productos" class="py-24 px-4 max-w-7xl mx-auto overflow-hidden">
  <div class="text-center mb-16">
    <h2 class="text-4xl md:text-5xl font-bold text-stone-800 mb-4 font-['Playfair_Display']">Colección Exclusiva</h2>
    <div class="w-24 h-1 bg-amber-500 mx-auto rounded-full mb-6"></div>
    <p class="text-stone-600 max-w-2xl mx-auto text-lg italic">
      Descubre la maestría del tejido Zenú en cada una de nuestras piezas hechas a mano con caña flecha.
    </p>
  </div>
  
  <div class="relative">
    <ProductosCarousel client:load />
  </div>
</section>
